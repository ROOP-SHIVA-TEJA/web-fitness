/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #111;
    color: white;
}

/* Header */
header {
    background: #080808;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 28px;
    color: white;
}

.logo span {
    color: #ff4d24;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    font-size: 15px;
}

nav a:hover {
    color: #ff4d24;
}

/* Hero Section */
.hero {
    min-height: 500px;
    background: linear-gradient(
        rgba(0,0,0,0.65),
        rgba(0,0,0,0.65)
    ),
    url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48")
    center/cover no-repeat;

    display: flex;
    align-items: center;
    padding: 50px 10%;
}

.hero-content h1 {
    font-size: 55px;
    margin-bottom: 15px;
}

.hero-content h1 span {
    color: #ff4d24;
}

.hero-content p {
    font-size: 20px;
    margin-bottom: 25px;
}

/* Buttons */
.btn {
    display: inline-block;
    background: #ff4d24;
    color: white;
    padding: 12px 25px;
    text-decoration: none;
    border-radius: 5px;
    margin-top: 15px;
    border: none;
}

.btn:hover {
    background: #e63810;
}

/* Common Sections */
.section {
    padding: 65px 8%;
    text-align: center;
}

.section h2 {
    font-size: 30px;
    margin-bottom: 35px;
    color: #ff4d24;
}

/* Cards */
.cards {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

.card {
    background: #222;
    padding: 30px 20px;
    border-radius: 10px;
    width: 280px;
    border: 1px solid #444;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    border-color: #ff4d24;
}

.card h3 {
    color: #ff4d24;
    margin-bottom: 15px;
}

.card p {
    color: #ccc;
    line-height: 1.6;
    margin-bottom: 10px;
}

.card h2 {
    margin-bottom: 15px;
}

.featured {
    border: 2px solid #ff4d24;
}

/* Trainers */
.trainers {
    background: #191919;
}

/* Facilities */
.facilities {
    background: #191919;
}

/* Registration */
.registration {
    background: #222;
}

form {
    max-width: 450px;
    margin: auto;
}

form input,
form select {
    width: 100%;
    padding: 14px;
    margin-bottom: 15px;
    border: none;
    border-radius: 5px;
    font-size: 15px;
}

form button {
    width: 100%;
    padding: 14px;
    background: #ff4d24;
    color: white;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    cursor: pointer;
}

form button:hover {
    background: #e63810;
}

.registration p {
    margin-top: 15px;
    color: #ccc;
}

/* Footer */
footer {
    background: #080808;
    padding: 20px;
    text-align: center;
    color: #aaa;
}

/* Mobile Responsive */
@media (max-width: 768px) {

    header {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    nav a {
        margin: 0;
        font-size: 13px;
    }

    .hero {
        min-height: 400px;
        text-align: center;
        justify-content: center;
    }

    .hero-content h1 {
        font-size: 36px;
    }

    .hero-content p {
        font-size: 16px;
    }

    .section {
        padding: 45px 5%;
    }

    .section h2 {
        font-size: 24px;
    }

    .card {
        width: 100%;
        max-width: 350px;
    }
}
