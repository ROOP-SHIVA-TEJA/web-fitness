<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitZone Fitness Center</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation -->
    <header>
        <h2 class="logo">FIT<span>ZONE</span></h2>

        <nav>
            <a href="#home">Home</a>
            <a href="#programs">Programs</a>
            <a href="#trainers">Trainers</a>
            <a href="#membership">Membership</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <!-- Home Section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <h1>BUILD YOUR <span>STRENGTH</span></h1>
            <p>Train Hard. Stay Strong. Live Healthy.</p>
            <a href="#membership" class="btn">Join Now</a>
        </div>
    </section>

    <!-- Programs Section -->
    <section class="section" id="programs">
        <h2>OUR WORKOUT PROGRAMS</h2>

        <div class="cards">
            <div class="card">
                <h3>Weight Training</h3>
                <p>Improve strength with structured resistance exercises.</p>
            </div>

            <div class="card">
                <h3>Cardio Training</h3>
                <p>Improve stamina and cardiovascular fitness.</p>
            </div>

            <div class="card">
                <h3>Yoga & Fitness</h3>
                <p>Improve flexibility, balance and relaxation.</p>
            </div>
        </div>
    </section>

    <!-- Trainers Section -->
    <section class="section trainers" id="trainers">
        <h2>OUR PROFESSIONAL TRAINERS</h2>

        <div class="cards">
            <div class="card">
                <h3>Rahul Kumar</h3>
                <p>Strength Training Coach</p>
            </div>

            <div class="card">
                <h3>Priya Sharma</h3>
                <p>Yoga & Fitness Coach</p>
            </div>

            <div class="card">
                <h3>Arjun Reddy</h3>
                <p>Personal Fitness Trainer</p>
            </div>
        </div>
    </section>

    <!-- Membership Section -->
    <section class="section" id="membership">
        <h2>MEMBERSHIP PLANS</h2>

        <div class="cards">
            <div class="card">
                <h3>Basic Plan</h3>
                <h2>₹999</h2>
                <p>1 Month Membership</p>
                <p>Gym Access</p>
                <a href="#contact" class="btn">Choose Plan</a>
            </div>

            <div class="card featured">
                <h3>Standard Plan</h3>
                <h2>₹2499</h2>
                <p>3 Months Membership</p>
                <p>Gym + Cardio Access</p>
                <a href="#contact" class="btn">Choose Plan</a>
            </div>

            <div class="card">
                <h3>Premium Plan</h3>
                <h2>₹4999</h2>
                <p>6 Months Membership</p>
                <p>All Facilities + Trainer Support</p>
                <a href="#contact" class="btn">Choose Plan</a>
            </div>
        </div>
    </section>

    <!-- Facilities Section -->
    <section class="section facilities">
        <h2>OUR FACILITIES</h2>

        <div class="cards">
            <div class="card">
                <h3>Modern Equipment</h3>
                <p>Modern gym machines and fitness equipment.</p>
            </div>

            <div class="card">
                <h3>Personal Training</h3>
                <p>Professional guidance for your fitness journey.</p>
            </div>

            <div class="card">
                <h3>Clean Environment</h3>
                <p>Clean, comfortable and friendly workout space.</p>
            </div>
        </div>
    </section>

    <!-- Registration Section -->
    <section class="section registration" id="contact">
        <h2>JOIN FITZONE TODAY</h2>

        <form>
            <input type="text" placeholder="Enter Your Name" required>

            <input type="email" placeholder="Enter Your Email" required>

            <input type="tel" placeholder="Enter Your Phone Number" required>

            <select required>
                <option value="">Select Membership Plan</option>
                <option>Basic Plan</option>
                <option>Standard Plan</option>
                <option>Premium Plan</option>
            </select>

            <button type="submit">Register Now</button>
        </form>

        <p>Email: fitzone@gmail.com</p>
        <p>Phone: +91 98765 43210</p>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 FitZone Fitness Center. All Rights Reserved.</p>
    </footer>

</body>
</html>
